<%- include('partials/head', { pageTitle: 'Collection' }) %>

<main>
  <section class="hero">
    <div class="hero-overline">
      <span class="gold-dash"></span>
      AN INDEX OF STORIES, IDEAS & EVERYTHING BETWEEN
    </div>

    <div class="hero-main">
      <div>
        <div class="hero-script">Welcome to</div>
        <h1>
          THE<br>
          <em>ARCHIVE<span class="hero-period">.</span></em>
        </h1>
      </div>

      <div class="hero-aside">
        <div class="hero-asterisk" aria-hidden="true">✳</div>
        <p>
          A home for the books you’ve read, the ones you love, and the stories
          still waiting to be opened.
        </p>
        <a class="text-link" href="/books/new">
          ADD A NEW VOLUME <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="hero-bottom">
      <span>
        YOUR PERSONAL COLLECTION <span class="muted">/ EST. TODAY</span>
      </span>
      <span>SCROLL TO EXPLORE <span aria-hidden="true">↓</span></span>
    </div>
  </section>

  <section class="collection" aria-labelledby="collection-heading">
    <div class="section-top">
      <div>
        <p class="eyebrow">01 / THE COLLECTION</p>
        <h2 id="collection-heading">Your <em>bookshelf.</em></h2>
      </div>

      <div class="collection-count">
        <strong><%= String(books.length).padStart(2, '0') %></strong>
        <span>VOLUMES<br>IN COLLECTION</span>
      </div>
    </div>

    <div class="collection-tools">
      <div class="filter-group" role="group" aria-label="Filter collection">
        <button type="button" class="filter active" data-filter="all">
          ALL <span><%= books.length %></span>
        </button>
        <button type="button" class="filter" data-filter="reading">
          TO READ <span><%= books.filter(book => !book.completed).length %></span>
        </button>
        <button type="button" class="filter" data-filter="finished">
          FINISHED <span><%= books.filter(book => book.completed).length %></span>
        </button>
      </div>

      <span class="sort-label">CURATED, ONE BOOK AT A TIME ✳</span>
    </div>

    <% if (books.length) { %>
      <div class="book-grid">
        <% books.forEach((book, index) => { %>
          <article
            class="book-card"
            data-status="<%= book.completed ? 'finished' : 'reading' %>"
          >
            <a
              class="cover-link"
              href="/books/<%= book._id %>"
              aria-label="View <%= book.title %>"
            >
              <%- include('partials/cover', { book, coverIndex: index }) %>
              <span class="cover-action">
                EXPLORE VOLUME <span aria-hidden="true">↗</span>
              </span>
            </a>

            <div class="card-meta">
              <span>NO. <%= String(index + 1).padStart(3, '0') %></span>
              <span class="status <%= book.completed ? 'status-done' : '' %>">
                <span class="status-dot"></span>
                <%= book.completed ? 'FINISHED' : 'TO READ' %>
              </span>
            </div>

            <div class="card-info">
              <a href="/books/<%= book._id %>">
                <h3><%= book.title %></h3>
              </a>
              <p>BY <%= book.author %></p>
            </div>

            <div class="card-bottom">
              <a
                href="/books/<%= book._id %>"
                aria-label="View <%= book.title %>"
              >
                VIEW THE VOLUME <span aria-hidden="true">↗</span>
              </a>
              <a
                href="/books/<%= book._id %>/edit"
                aria-label="Edit <%= book.title %>"
              >
                EDIT
              </a>
            </div>
          </article>
        <% }) %>
      </div>

      <p id="filter-empty" class="filter-empty" hidden>
        There are no books in this chapter yet.
        <a href="/books/new">Add one ↗</a>
      </p>
    <% } else { %>
      <div class="empty-state">
        <span class="empty-symbol">✳</span>
        <h3>A blank page, for now.</h3>
        <p>Every great collection begins with a single volume.</p>
        <a class="primary-button" href="/books/new">
          ADD THE FIRST VOLUME <span aria-hidden="true">↗</span>
        </a>
      </div>
    <% } %>
  </section>

  <section class="closing-cta">
    <div class="closing-icon">✳</div>
    <p>THE NEXT CHAPTER AWAITS</p>
    <h2>There's always room<br>for <em>one more story.</em></h2>
    <a href="/books/new" class="primary-button">
      ADD TO THE ARCHIVE <span aria-hidden="true">↗</span>
    </a>
  </section>
</main>

<%- include('partials/foot') %>